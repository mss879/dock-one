# ─────────────────────────────────────────────────────────────────────────────
# Dock One Solutions — environment variables
#
# Copy to `.env.local` for development. On Vercel, set them in Project → Settings →
# Environment Variables (Production AND Preview). Never commit real values.
#
# There is deliberately NO Supabase service-role key: all privileged work happens in
# SECURITY DEFINER functions that re-check the caller (blueprint §3.3).
#
# Secrets marked "must equal app_config.<name>" are generated IN the database (see the
# OPS NOTE at the end of each migration) and then pasted here — the same value in both places.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase (public, REQUIRED) ──────────────────────────────────────────────
# Project URL and anon key (Supabase → Project Settings → API). The anon key ships in the
# browser bundle by design; RLS + RPCs are what protect the data.
# Unset: a production build / `next start` THROWS (never a silent mock store). In
# development the storefront renders with empty catalogue data and logs one warning.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin (no trailing slash): metadataBase, canonical URLs, sitemap, email links.
# Unset: falls back to https://dockone.lk (placeholder domain) — set it before launch.
NEXT_PUBLIC_SITE_URL=


# ── Request boundary ─────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Must equal app_config.rate_limit (≥ 20 chars; see
# supabase/migrations/01_foundation.sql). Also the HMAC key that hashes IPs/emails into
# rate-limit bucket names, and the key of the x-dockone-route header the server sends so the
# database can tell the app's own calls from direct PostgREST calls (which share a small
# store-wide budget). Unset or short: EVERY rate limit fails open and the server logs
# "RATE LIMITING IS OFF" at startup — treat that as a deploy error. A value that differs from
# the database makes the store run on those small direct-call budgets: keep them equal.
RATE_LIMIT_SECRET=

# Header the host sets from the real socket (cannot be forged by the client).
# Vercel: x-real-ip (default) · Netlify: x-nf-client-connection-ip · Cloudflare: cf-connecting-ip.
# Unset: x-real-ip, then the FIRST x-forwarded-for entry (client-writable — last resort).
CLIENT_IP_HEADER=


# ── Email (Resend) ───────────────────────────────────────────────────────────
# Unset API key or sender: the store works but sends nothing; every skipped email is logged
# ("[email] not configured — skipped …") and admin toasts say the customer wasn't notified.
RESEND_API_KEY=
# Verified sender (SPF/DKIM on the domain), e.g. "Dock One Solutions <orders@dockone.lk>".
RESEND_FROM_EMAIL=
# Optional: where customer replies go. Unset: replies go to the sender address.
RESEND_REPLY_TO=
# Optional: owner alerts (new order, new inquiry). Unset: falls back to RESEND_REPLY_TO, then
# RESEND_FROM_EMAIL. None valid: owner alerts are skipped (logged).
ORDER_NOTIFICATION_EMAIL=
# Also configure Resend as CUSTOM SMTP in Supabase Auth before launch, or sign-up and
# password-reset emails stall at ~2/hour (blueprint §3.2).


# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Hourly POST /api/cart-recovery with "Authorization: Bearer <secret>".
# Must equal app_config.cart_recovery (≥ 20 chars). Unset: the job answers 401/503 and no
# abandoned-cart reminders are sent (the admin "Send due reminders" button still needs it).
CART_RECOVERY_SECRET=

# Daily POST /api/maintenance with "Authorization: Bearer <secret>" (retention housekeeping).
# Must equal app_config.maintenance (≥ 20 chars). Unset: the job answers 401/503 and old
# analytics/assistant/rate-limit rows are not pruned.
MAINTENANCE_SECRET=

# Business time zone for reports and admin aggregate SQL. Unset: Asia/Colombo.
TIMEZONE=


# ── Display currency ─────────────────────────────────────────────────────────
# LKR-based rates endpoint for the display-currency switcher (presentation only — orders are
# always charged in LKR). Fetched server-side, cached 12 h. Must return
# { "result": "success", "base_code": "LKR", "rates": { "USD": 0.0033, … } }.
# Unset: https://open.er-api.com/v6/latest/LKR. Down or malformed: a static fallback table.
FX_API_URL=


# ── AI shopping assistant ("the Dock One tech desk") ──────────────────────────
# OpenAI API key (blueprint §3.3 — the assistant uses the Vercel AI SDK + @ai-sdk/openai).
# Unset: the widget answers a friendly "the tech desk is away" message and nothing is sent anywhere.
OPENAI_API_KEY=
# Model for text turns. Bake-off 2026-10-01 through the real prompt + tools (24 s turn budget):
# gpt-5.4-mini answered every test in 8–14 s; gpt-5.4 took 14–18 s and timed out once; gpt-5.5
# timed out on every turn. Unset: gpt-5.4-mini (named once, in src/lib/assistant/model.ts).
ASSISTANT_MODEL=gpt-5.4-mini
# Separate image-capable model for photo turns. Same bake-off: every model read a printed model
# name, a mouse, a keyboard and headphones correctly; gpt-5.6-terra was the fastest (5–11 s per
# photo, $2.50/$15 per 1M tokens vs $0.75/$4.50 for gpt-5.4-mini — photo turns are rare and
# rate-limited, so the stronger reader is worth it). Unset: ASSISTANT_MODEL.
ASSISTANT_VISION_MODEL=gpt-5.6-terra
# "off" disables photo input (text chat keeps working). Unset: photos enabled.
ASSISTANT_VISION=on
